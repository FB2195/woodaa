# Metro (React Native's bundler, used by apps/mobile), the Expo/RN Gradle
# build, and Babel's own preset-resolution chain all assume npm/yarn's
# flat, hoisted node_modules - they resolve a package's OWN transitive
# dependencies (expo's dependency on expo-asset, react-native's on
# @react-native/gradle-plugin, babel-preset-expo's on
# @babel/plugin-transform-react-jsx, ...) via plain upward node_modules
# lookup from apps/mobile, which pnpm's default symlinked/non-flat layout
# doesn't satisfy. Tried narrowing this to public-hoist-pattern for just
# the expo-*/@react-native/*/@expo/* families first, but each EAS build
# surfaced a new offender one dependency layer deeper (a losing game of
# whack-a-mole against Metro/Babel's sprawling transitive graph) - this is
# also what Expo's own docs recommend for pnpm projects.
shamefully-hoist=true
