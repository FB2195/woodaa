# Metro (React Native's bundler, used by apps/mobile) and the Expo/RN
# Gradle build assume npm/yarn's flat, hoisted node_modules - they resolve
# a package's OWN transitive dependencies (e.g. expo's dependency on
# expo-asset, react-native's on @react-native/gradle-plugin) via plain
# upward node_modules lookup from apps/mobile, which pnpm's default
# symlinked/non-flat layout doesn't satisfy. Hoisting just these families
# to the root node_modules fixes that without going as broad as
# shamefully-hoist=true (which would hoist everything, for every app in
# the monorepo, not just the RN/Expo native-module family).
public-hoist-pattern[]=@react-native/*
public-hoist-pattern[]=expo-*
public-hoist-pattern[]=@expo/*
