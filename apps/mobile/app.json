{
  "expo": {
    "name": "woodaa",
    "slug": "woodaa",
    "scheme": "woodaa",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF9F5",
    "splash": {
      "backgroundColor": "#FAF9F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.woodaa.app"
    },
    "android": {
      "package": "de.woodaa.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F5"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"]
  }
}
