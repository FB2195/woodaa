{
  "expo": {
    "name": "woodaa",
    "slug": "woodaa",
    "scheme": "woodaa",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF9F5",
    "splash": {
      "backgroundColor": "#FAF9F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.woodaa.app"
    },
    "android": {
      "package": "de.woodaa.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F5"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "woodaa nutzt deinen Standort, um Pflegeplätze in deiner Nähe zu finden."
        }
      ],
      "@stripe/stripe-react-native"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5368289e-aa30-4244-ab25-9425dbc9259e"
      }
    },
    "owner": "fb1995"
  }
}
