{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.woodaa.de"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {},
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.woodaa.de"
      }
    }
  },
  "submit": {
    "production": {},
    "testflight": {}
  }
}
