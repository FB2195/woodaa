# --- packages/db ---
# Postgres connection string (Neon in production, local Postgres for dev)
DATABASE_URL="postgresql://user:password@localhost:5432/woodaa"
# Unpooled/direct connection, used only for running migrations (Neon's
# pooled endpoint doesn't support the multi-statement DDL sessions
# `prisma migrate` needs). In production this is Neon's non-"-pooler" host,
# auto-provisioned by the Neon integration as DATABASE_URL_UNPOOLED. For
# local Postgres (no pooler involved) this can just be the same value as
# DATABASE_URL above.
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/woodaa"

# --- apps/api ---
PORT=4000
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_EMAIL_VERIFICATION_SECRET="change-me"
JWT_TWO_FACTOR_SECRET="change-me"
JWT_PASSWORD_RESET_SECRET="change-me"
# 32-byte key, base64-encoded, e.g. `openssl rand -base64 32`. Encrypts
# TOTP secrets and other at-rest secrets (e.g. Versicherungsnummer) - see
# packages/api/src/crypto.ts.
TOTP_ENCRYPTION_KEY=""

# Resend (transactional email, e.g. https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Woodaa <onboarding@resend.dev>"
# Base URL used to build links in emails (defaults to VERCEL_URL in production)
APP_URL="http://localhost:3000"

# Google Places API (search-box autocomplete). Leave unset to fall back to
# the free Nominatim-based suggestions (lower quality, no key needed).
GOOGLE_PLACES_API_KEY=""

# Cloudflare R2 (facility photos, verification docs)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="woodaa"
# Public base URL for reading uploaded objects back (r2.dev subdomain for
# now, e.g. "https://pub-xxxxxxxx.r2.dev" - swap for a custom-domain CNAME
# later with zero code changes). No trailing slash.
R2_PUBLIC_URL=""

# Stripe (Karte/Klarna/PayPal bei der Buchung, siehe packages/api/src/stripe.ts).
# Testmodus-Werte reichen zum Entwickeln/Testen aus, kein echtes Bankkonto
# nötig - siehe Stripe-Dashboard: Entwickler > API-Schlüssel /
# Entwickler > Webhooks (Event "payment_intent.succeeded").
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Single-Kasse pilot for the "Antrag digital einreichen" flow (see
# packages/api/src/routers/careApplication.ts) - deliberately not stored in
# the DB/seed data, since this is real-world config that must never ship
# with a placeholder or test address. Leave both unset to disable the
# feature (facilities without a configured Kasse just don't see the
# "Jetzt online einreichen" option).
PILOT_KRANKENKASSE_NAME=""
PILOT_KRANKENKASSE_EMAIL=""

# --- apps/web ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Stripe publishable key (safe to expose client-side) - pairs with
# STRIPE_SECRET_KEY above, same Stripe account/mode.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Site-wide HTTP Basic Auth gate while not ready for public visitors.
# Leave unset to disable the gate (e.g. local dev).
SITE_PASSWORD=""

# --- apps/mobile ---
EXPO_PUBLIC_API_URL="http://localhost:4000"
