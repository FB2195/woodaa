{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "JWT_EMAIL_VERIFICATION_SECRET",
        "JWT_TWO_FACTOR_SECRET",
        "TOTP_ENCRYPTION_KEY",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "APP_URL",
        "SITE_PASSWORD",
        "GOOGLE_PLACES_API_KEY"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "JWT_EMAIL_VERIFICATION_SECRET",
        "JWT_TWO_FACTOR_SECRET",
        "TOTP_ENCRYPTION_KEY",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "APP_URL",
        "SITE_PASSWORD",
        "GOOGLE_PLACES_API_KEY"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
