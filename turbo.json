{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "VERCEL_ENV",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "JWT_EMAIL_VERIFICATION_SECRET",
        "JWT_TWO_FACTOR_SECRET",
        "JWT_PASSWORD_RESET_SECRET",
        "JWT_EMAIL_CHANGE_SECRET",
        "TOTP_ENCRYPTION_KEY",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "PILOT_KRANKENKASSE_NAME",
        "PILOT_KRANKENKASSE_EMAIL",
        "APP_URL",
        "SITE_PASSWORD",
        "GOOGLE_PLACES_API_KEY",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET_NAME",
        "R2_PUBLIC_URL",
        "VITE_API_URL",
        "SENTRY_DSN"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "JWT_EMAIL_VERIFICATION_SECRET",
        "JWT_TWO_FACTOR_SECRET",
        "JWT_PASSWORD_RESET_SECRET",
        "JWT_EMAIL_CHANGE_SECRET",
        "TOTP_ENCRYPTION_KEY",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "PILOT_KRANKENKASSE_NAME",
        "PILOT_KRANKENKASSE_EMAIL",
        "APP_URL",
        "SITE_PASSWORD",
        "GOOGLE_PLACES_API_KEY",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET_NAME",
        "R2_PUBLIC_URL",
        "SENTRY_DSN"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL"],
      "cache": false
    }
  }
}
