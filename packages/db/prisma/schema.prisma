generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingType {
  STATIONAERE_AUFNAHME
  KURZZEITPFLEGE
  TAGES_NACHTPFLEGE
}

enum FacilityStatus {
  ACTIVE
  PENDING_REVIEW
}

enum BookingRequestStatus {
  OFFEN
  KONTAKTIERT
  ABGESCHLOSSEN
  ABGELEHNT
}

model Facility {
  id              String             @id @default(cuid())
  slug            String             @unique
  name            String
  description     String
  street          String
  postalCode      String
  city            String
  state           String
  amenities       String[]
  status          FacilityStatus     @default(PENDING_REVIEW)
  operatorName    String
  operatorEmail   String
  operatorPhone   String?
  capacities      FacilityCapacity[]
  bookingRequests BookingRequest[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model FacilityCapacity {
  id             String      @id @default(cuid())
  facility       Facility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId     String
  bookingType    BookingType
  totalSlots     Int
  availableSlots Int

  @@unique([facilityId, bookingType])
}

model BookingRequest {
  id             String               @id @default(cuid())
  facility       Facility             @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId     String
  bookingType    BookingType
  requesterName  String
  requesterEmail String
  requesterPhone String?
  pflegegrad     Int?
  message        String?
  desiredStart   DateTime?
  status         BookingRequestStatus @default(OFFEN)
  createdAt      DateTime             @default(now())
}
