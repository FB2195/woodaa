generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled endpoint (DATABASE_URL, "-pooler" host) runs in
  // transaction-pooling mode, which breaks multi-statement DDL sessions
  // (explicit BEGIN/COMMIT blocks, CREATE EXTENSION advisory locks) used by
  // `prisma migrate deploy`. directUrl routes migrations to the unpooled
  // connection instead; ordinary Prisma Client queries still use `url`.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum BookingType {
  STATIONAERE_AUFNAHME
  KURZZEITPFLEGE
  TAGESPFLEGE
  NACHTPFLEGE
}

enum UnitBookingSource {
  ONLINE // sofort verbindliche Buchung über Woodaa
  TELEFON
  VOR_ORT
}

enum UnitBookingStatus {
  BESTAETIGT
  STORNIERT
}

enum FacilityStatus {
  ACTIVE
  PENDING_REVIEW
  REJECTED
}

enum BookingRequestStatus {
  OFFEN
  KONTAKTIERT
  ABGESCHLOSSEN
  ABGELEHNT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  SUCHENDE
  BETREIBER
  ADMIN
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  passwordHash            String
  name                    String
  role                    Role      @default(SUCHENDE)
  emailVerifiedAt         DateTime?
  verificationEmailSentAt DateTime?
  failedLoginAttempts     Int       @default(0)
  lockedUntil             DateTime?
  twoFactorSecret         String?
  twoFactorEnabled        Boolean   @default(false)
  facility                Facility? @relation("FacilityOperator")
  refreshTokens           RefreshToken[]
  recoveryCodes           RecoveryCode[]
  favorites               Favorite[]
  passwordResetTokens     PasswordResetToken[]
  createdAt               DateTime  @default(now())
}

// Hashed (SHA-256), not raw — a DB leak shouldn't yield directly reusable
// bearer tokens. Rotated on every use; familyId ties a rotation chain
// together so reuse of an already-rotated token can revoke the whole chain.
model RefreshToken {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @unique
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

// One-time TOTP recovery codes, generated on 2FA setup confirmation.
// Hashed like RefreshToken, individually markable as used.
model RecoveryCode {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Hybrid like RefreshToken: a real JWT (see auth.ts) for fast, tamper-proof
// verification, plus a SHA-256-hashed DB row with expiresAt/usedAt so the
// link is genuinely single-use (unlike the stateless email-verification
// token) and revocable server-side.
model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Facility {
  id                     String                   @id @default(cuid())
  slug                   String                   @unique
  name                   String
  // Empty ("") until the operator fills it in - only required to go public
  // (ACTIVE), not to use the internal availability tool (PENDING_REVIEW is
  // fully functional). See requireDescriptionForPublicListing in
  // operator.ts.
  description            String                   @default("")
  street                 String
  postalCode             String
  city                   String
  state                  String
  amenities              String[]
  // Best-effort geocoded from street/postalCode/city on create/update
  // (packages/api/src/geocoding.ts) - null if geocoding failed or hasn't
  // run yet, in which case the facility just doesn't show on the map.
  latitude               Float?
  longitude              Float?
  // Pflegegrad-Eignung (0-5). Facility-level, not per-capacity - suitability
  // realistically doesn't vary by booking type within one home. Both null =
  // "not specified", so the facility stays visible under any Pflegegrad
  // filter rather than silently disappearing (fail-open, not fail-closed).
  minPflegegrad          Int?
  maxPflegegrad          Int?
  status                 FacilityStatus           @default(PENDING_REVIEW)
  operatorName           String
  operatorEmail          String
  operatorPhone          String?
  operatorUserId         String?                  @unique
  operator               User?                    @relation("FacilityOperator", fields: [operatorUserId], references: [id])
  capacities             FacilityCapacity[]
  units                  FacilityUnit[]
  bookings               Booking[]
  bookingRequests        BookingRequest[]
  favoritedBy            Favorite[]
  photos                 FacilityPhoto[]
  reviews                Review[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
}

model Favorite {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId String
  createdAt  DateTime @default(now())

  @@unique([userId, facilityId])
}

model FacilityCapacity {
  id             String      @id @default(cuid())
  facility       Facility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId     String
  bookingType    BookingType
  // totalSlots/availableSlots are a maintained cache, not operator input:
  // the single writer is availability.ts (syncCapacityCache), called
  // transactionally after every FacilityUnit/Booking change. Source of
  // truth is always FacilityUnit + Booking - these two columns exist only
  // so search/list can filter and display without recomputing per request.
  totalSlots     Int
  availableSlots Int
  // Geschätzter monatlicher Eigenanteil, in Cent (avoids float rounding on
  // sort/compare). Null = not entered yet -> "Preis auf Anfrage", sorts last
  // under price_asc, never excludes a facility unless maxPriceCents is set.
  monthlyPriceCents Int?
  // STATIONAERE_AUFNAHME: earliest date a place opens up (e.g. all slots
  // currently full, but one frees up on this date).
  availableFrom  DateTime?

  @@unique([facilityId, bookingType])
}

// Ein einzelner buchbarer Platz/Bett innerhalb einer Kategorie. Reine
// Identität (kein Status-Feld) - ob ein Platz gerade belegt ist, wird immer
// live aus den aktiven Booking-Zeilen abgeleitet (siehe availability.ts),
// nie separat gecacht, damit Anzeige und Wahrheit nie auseinanderlaufen
// können. label ist auto-generiert ("Platz 1", ...) und vom Betreiber
// umbenennbar (z.B. "Zimmer 4").
model FacilityUnit {
  id          String            @id @default(cuid())
  facility    Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId  String
  bookingType BookingType
  label       String
  createdAt   DateTime          @default(now())
  bookings    Booking[]

  @@index([facilityId, bookingType])
}

// Eine einzelne Belegung eines Platzes.
// - STATIONAERE_AUFNAHME: startDate/endDate bleiben null (unbefristet belegt
//   bis storniert = Auszug).
// - KURZZEITPFLEGE/TAGESPFLEGE/NACHTPFLEGE: konkreter Zeitraum, beide Enden
//   inklusiv (bei Tages-/Nachtpflege ist startDate = endDate = der gebuchte
//   Tag). Ein Platz wird frühestens am Folgetag nach einer Abreise wieder
//   für denselben Platz belegbar (Tagesgranularität, keine Uhrzeit) - bei
//   mehreren Plätzen pro Kategorie fällt das in der Praxis nicht auf, weil
//   die Zuteilung automatisch einen anderen freien Platz wählt.
//
// Überlappende aktive Buchungen auf demselben Platz sind über einen
// EXCLUDE-Constraint auf DB-Ebene unmöglich gemacht (siehe Migration
// 20260804_availability_engine) - das ist die eigentliche
// Doppelbuchungssperre, nicht Applikationscode mit Locking/Retries.
model Booking {
  id          String            @id @default(cuid())
  facility    Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId  String
  unit        FacilityUnit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId      String
  bookingType BookingType
  source      UnitBookingSource
  status      UnitBookingStatus @default(BESTAETIGT)
  startDate   DateTime?
  endDate     DateTime?
  guestName   String?
  guestEmail  String?
  guestPhone  String?
  note        String?
  createdAt   DateTime          @default(now())
  cancelledAt DateTime?

  @@index([facilityId, bookingType])
  @@index([unitId, status])
}

// Object storage lives in Cloudflare R2 - only the bucket object `key` is
// stored here (e.g. "facilities/<facilityId>/<uuid>.jpg"), never a full
// URL, so swapping the public base URL (r2.dev -> a custom domain later)
// needs no data migration. Ordered by createdAt: the oldest photo is the
// implicit cover/thumbnail (no separate order/isCover field in v1).
//
// key is nullable to also represent designed placeholder tiles (see
// apps/web/components/PlaceholderPhoto.tsx): rows with key = null carry no real image,
// just a `category` the frontend renders as a styled illustration instead
// of an <img>. Lets demo/seed facilities show a full gallery without a real
// photo upload pipeline, using the exact same gallery UI real uploads use.
model FacilityPhoto {
  id         String        @id @default(cuid())
  facility   Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId String
  key        String?
  category   PhotoCategory?
  createdAt  DateTime      @default(now())

  @@index([facilityId])
}

enum PhotoCategory {
  AUSSENANSICHT
  GARTEN
  STATION
  ZIMMER
  SONSTIGE
}

// Only a Suchende who can prove genuine prior contact with the facility (a
// case-insensitive matching BookingRequest.requesterEmail - see review.ts)
// may create one; every row starts PENDING and only becomes publicly
// visible once an admin approves it (same moderation shape as
// FacilityStatus.PENDING_REVIEW). reviewerEmail is stored but never
// surfaced to other users - same trust/display treatment as
// BookingRequest.requesterEmail. @@unique enforces "one review per person
// per facility" at the DB level instead of a racy check-then-create.
model Review {
  id                String       @id @default(cuid())
  facility          Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId        String
  reviewerName      String
  reviewerEmail     String
  rating            Int
  careRating        Int?
  cleanlinessRating Int?
  foodRating        Int?
  staffRating       Int?
  comment           String?
  status            ReviewStatus @default(PENDING)
  createdAt         DateTime     @default(now())

  @@unique([facilityId, reviewerEmail])
  @@index([facilityId])
}

model BookingRequest {
  id             String               @id @default(cuid())
  facility       Facility             @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId     String
  bookingType    BookingType
  requesterName  String
  requesterEmail String
  requesterPhone String?
  pflegegrad     Int?
  message        String?
  desiredStart   DateTime?
  desiredEnd     DateTime?
  status         BookingRequestStatus @default(OFFEN)
  createdAt      DateTime             @default(now())
}
